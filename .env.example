# Salin file ini menjadi .env.local lalu sesuaikan.

# Alamat API back-end Laravel (tanpa garis miring di akhir).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Client Key Midtrans (bukan Server Key). Sandbox diawali "SB-Mid-client-".
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# true hanya untuk transaksi sungguhan
NEXT_PUBLIC_MIDTRANS_PRODUKSI=false
